# -*- coding: utf-8 -*-
import os
import sys
import subprocess
import importlib
import importlib.util
from pathlib import Path
import tkinter as tk
from tkinter import filedialog

# ============================ 全局变量 ============================
ROOT_DIR = ""  # 游戏根目录
TRANSLATION_DIR = "schinese"  # 翻译文件夹名称

# ============================ 通用函数 ============================
def get_root_dir():
    """获取根目录，兼容脚本和exe两种运行方式"""
    if getattr(sys, 'frozen', False):
        return os.path.dirname(sys.executable)
    else:
        return os.path.dirname(os.path.abspath(__file__))

def select_game_root():
    """选择游戏根目录"""
    print("正在打开文件夹选择对话框...")
    root = tk.Tk()
    root.withdraw()
    
    selected_dir = filedialog.askdirectory(title="请选择游戏根目录")
    root.destroy()
    
    if selected_dir:
        global ROOT_DIR
        ROOT_DIR = selected_dir
        print(f"✓ 已选择游戏根目录: {ROOT_DIR}")
        return True
    else:
        print("✗ 未选择目录，使用默认目录")
        return False

def select_translation_dir():
    """选择翻译文件夹"""
    print("\n请选择翻译文件夹：")
    print("1: schinese")
    print("2: chinese") 
    print("3: 自定义")
    
    while True:
        choice = input("请输入选择 (1/2/3): ").strip()
        if choice == "1":
            return "schinese"
        elif choice == "2":
            return "chinese"
        elif choice == "3":
            custom_dir = input("请输入自定义翻译文件夹名称: ").strip()
            if custom_dir:
                return custom_dir
            else:
                print("自定义翻译文件夹不能为空，请重新输入")
        else:
            print("无效选择，请重新输入")

def get_tl_path():
    """获取翻译文件夹完整路径"""
    if not ROOT_DIR:
        return None
    return os.path.join(ROOT_DIR, "game", "tl", TRANSLATION_DIR)

def ensure_root_dir():
    """确保游戏根目录已设置"""
    global ROOT_DIR
    if not ROOT_DIR:
        ROOT_DIR = get_root_dir()
        print(f"使用默认游戏根目录: {ROOT_DIR}")

def ensure_translation_dir():
    """确保翻译文件夹路径存在"""
    tl_path = get_tl_path()
    if tl_path and not os.path.exists(tl_path):
        print(f"警告：翻译文件夹不存在: {tl_path}")
        return False
    return True

def clear_screen():
    """清屏函数"""
    import os
    os.system('cls' if os.name == 'nt' else 'clear')

def wait_for_return():
    """等待用户按回车键"""
    input("按回车键返回主菜单...")

# ============================ 功能区一函数 ============================

def script_00():
    """00.选择游戏根目录"""
    print("=== 执行: 00.选择游戏根目录 ===")
    print("按enter选择游戏根目录，按Esc键退出脚本 (enter/esc): ")
    
    try:
        import msvcrt
        key = msvcrt.getch().decode('utf-8').lower()
    except:
        key = input().strip().lower()
    
    if key in ('\r', '\n', '', 'enter'):
        if select_game_root():
            global TRANSLATION_DIR
            TRANSLATION_DIR = select_translation_dir()
            print(f"✓ 已选择翻译文件夹: {TRANSLATION_DIR}")
            print("游戏根目录和翻译文件夹选择成功！")
        else:
            print("游戏根目录选择取消。")
    elif key in ('\x1b', 'esc'):
        print("退出脚本")
        sys.exit()
    else:
        print("无效输入，返回主菜单。")
    
    wait_for_return()

def script_01():
    """01.删除 rpyc"""
    print("=== 执行: 01.删除 rpyc ===")
    ensure_root_dir()
    
    import os
    game_dir = os.path.join(ROOT_DIR, "game")
    rpyc_files = []

    for dirpath, dirnames, filenames in os.walk(game_dir):
        for file in filenames:
            if file.endswith(".rpyc"):
                rpyc_files.append(os.path.join(dirpath, file))

    if rpyc_files:
        print("开始删除 rpyc 文件：\n")
        for file_path in rpyc_files:
            try:
                os.remove(file_path)
                print(f"已删除: {file_path}")
            except Exception as e:
                print(f"删除失败: {file_path}，原因: {e}")
    else:
        print("未找到任何 rpyc 文件。")

    print("\n全部操作完成。")
    wait_for_return()

def script_02():
    """02.生成替换规则"""
    print("=== 执行: 02.生成替换规则 ===")
    ensure_root_dir()
    if not ensure_translation_dir():
        wait_for_return()
        return
    
    import os
    import re

    root_dir_local = ROOT_DIR
    MEMORY_A_PATH = os.path.join(root_dir_local, "记忆池A.txt")
    MEMORY_B_PATH = os.path.join(root_dir_local, "记忆池B.txt")
    RESULT_PATH = os.path.join(root_dir_local, "result.txt")

    def generate_placeholder(index):
        return f"<<占位_{index}>>"

    tl_dir = get_tl_path()
    pattern = r'"((?:\\.|[^"\\])*)"'
    memory_a_lines = []

    print("开始遍历 rpy 文件并提取引号内字符串...")
    file_count = 0
    for root, dirs, files in os.walk(tl_dir):
        for file in files:
            if file.endswith(".rpy"):
                file_count += 1
                file_path = os.path.join(root, file)
                with open(file_path, "r", encoding="utf-8", errors='ignore') as f:
                    content = f.read()
                    matches = re.findall(pattern, content)
                    memory_a_lines.extend(matches)

    with open(MEMORY_A_PATH, "w", encoding="utf-8") as f:
        for line in memory_a_lines:
            f.write(line + "\n")
    print(f"记忆池A生成完成，{len(memory_a_lines)}条记录")

    memory_b_set = set()
    for line in memory_a_lines:
        curly_matches = re.findall(r"\{[^{}]*\}", line)
        square_matches = re.findall(r"(?<!\[)\[[^\[\]]*\](?!\])", line)
        for m in curly_matches + square_matches:
            memory_b_set.add(m)

    memory_b_list = list(memory_b_set)
    with open(MEMORY_B_PATH, "w", encoding="utf-8") as f:
        for item in memory_b_list:
            f.write(item + "\n")
    print(f"记忆池B生成完成，{len(memory_b_list)} 条记录")

    result_lines = []
    for index, item in enumerate(memory_b_list, 1):
        placeholder = generate_placeholder(index)
        result_lines.append(f"{item}   {placeholder}")

    with open(RESULT_PATH, "w", encoding="utf-8") as f:
        for line in result_lines:
            f.write(line + "\n")
    print(f"result.txt生成完成，共{len(result_lines)}条配对记录")
    
    try:
        if os.path.exists(MEMORY_A_PATH):
            os.remove(MEMORY_A_PATH)
        if os.path.exists(MEMORY_B_PATH):
            os.remove(MEMORY_B_PATH)
        print("已自动删除临时记忆池文件：记忆池A.txt、记忆池B.txt")
    except Exception as e:
        print(f"删除临时文件时出错：{e}")

    print("执行完成，脚本不会自动关闭，请手动关闭。")
    wait_for_return()

def script_03():
    """03.生成正反替换表"""
    print("=== 执行: 03.生成正反替换表 ===")
    ensure_root_dir()
    
    import openpyxl
    import re
    import os

    root_dir_local = ROOT_DIR
    OUTPUT_FILENAME_POSITIVE = os.path.join(root_dir_local, "result正.xlsx")
    OUTPUT_FILENAME_NEGATIVE = os.path.join(root_dir_local, "result反.xlsx")
    INPUT_FILENAME = os.path.join(root_dir_local, "result.txt")

    def write_data_to_excel(filename, data_list, column_order, title="占位符数据"):
        try:
            print(f"正在写入文件: {filename} ...")
            workbook = openpyxl.Workbook()
            sheet = workbook.active
            sheet.title = title

            sheet.column_dimensions['A'].width = 40
            sheet.column_dimensions['B'].width = 40

            for row_index, (label, placeholder) in enumerate(data_list, 1):
                sheet.cell(row=row_index, column=1, value=(label, placeholder)[column_order[0]])
                sheet.cell(row=row_index, column=2, value=(label, placeholder)[column_order[1]])

            workbook.save(filename)
            print(f"✅ 写入完成: {filename}")
            return True
        except Exception as e:
            print(f"❌ 写入文件 {filename} 失败: {e}")
            return False

    def convert_txt_to_excel_dual(input_filename=INPUT_FILENAME):
        print("="*50)
        print("开始 Excel 转换流程...")
        print("="*50)

        try:
            with open(input_filename, 'r', encoding='utf-8') as f:
                lines = f.readlines()
            print(f"✅ 成功读取 {len(lines)} 行内容")
        except FileNotFoundError:
            print(f"❌ 错误: 找不到文件 {input_filename}。")
            wait_for_return()
            return
        except Exception as e:
            print(f"❌ 读取文件时发生错误: {e}")
            wait_for_return()
            return

        parsed_data = []
        pattern = re.compile(r'^\s*(.+?)\s+([^\s]+)\s*$', re.UNICODE)

        for line_number, line in enumerate(lines, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue

            match = pattern.match(line)
            if match:
                content = match.group(1).strip()
                emoji = match.group(2).strip()
                parsed_data.append((content, emoji))
            else:
                print(f"⚠️ 警告: 第 {line_number} 行未匹配成功，跳过: {line}")

        if not parsed_data:
            print("❌ 未解析到任何有效数据，程序终止。")
            wait_for_return()
            return

        print(f"✅ 数据解析完成，共 {len(parsed_data)} 条有效记录。")

        print("\n步骤3: 生成 Excel 文件")
        print("\n生成 result正.xlsx (正向)")
        success_positive = write_data_to_excel(
            OUTPUT_FILENAME_POSITIVE,
            parsed_data,
            column_order=(0, 1),
            title="正向对照"
        )

        print("\n生成 result反.xlsx (反向)")
        success_negative = write_data_to_excel(
            OUTPUT_FILENAME_NEGATIVE,
            parsed_data,
            column_order=(1, 0),
            title="反向对照"
        )

        print("\n" + "="*50)
        if success_positive and success_negative:
            print(f"✅ Excel 文件生成完成！")
        else:
            print(f"❌ Excel 文件生成过程中出现问题，请检查日志。")
        print(f"正向文件: {os.path.abspath(OUTPUT_FILENAME_POSITIVE)}")
        print(f"反向文件: {os.path.abspath(OUTPUT_FILENAME_NEGATIVE)}")
        print("="*50)

        wait_for_return()

    convert_txt_to_excel_dual()

def script_04():
    """04.提取人名2.1"""
    print("=== 执行: 04.提取人名2.1 ===")
    ensure_root_dir()
    if not ensure_translation_dir():
        wait_for_return()
        return
    
    import os
    import re
    from pathlib import Path

    GAME_ROOT = Path(ROOT_DIR)
    POOL_A = GAME_ROOT / "记忆池A.txt"
    POOL_B = GAME_ROOT / "记忆池B.txt"
    POOL_C = GAME_ROOT / "记忆池C.txt"
    POOL_D = GAME_ROOT / "记忆池D.txt"
    POOL_E = GAME_ROOT / "记忆池E.txt"
    NAME_DELE = GAME_ROOT / "NameDele.txt"
    NAME_TXT = GAME_ROOT / "name.txt"
    NAME_RPY = GAME_ROOT / "name.rpy"
    DEFINER_A = "\n----------------截断---------------\n"

    def log(message):
        print(f"[LOG] {message}")

    def step_2():
        log("步骤2: 检查/创建工作目录和文件...")
        for f in [POOL_A, POOL_B, POOL_C, POOL_D, POOL_E, NAME_DELE, NAME_TXT, NAME_RPY]:
            try:
                f.touch(exist_ok=True)
                with open(f, "w", encoding="utf-8") as file:
                    file.write("")
                log(f"  - 文件 {f.name} 确保存在并已清空。")
            except Exception as e:
                log(f"  - 错误: 无法创建或访问文件 {f.name}: {e}")
                return False
        log("步骤2 完成。")
        return True

    def step_3():
        log("步骤3: 遍历game目录并提取角色名到记忆池A...")
        game_dir = GAME_ROOT / "game"
        tl_dir = game_dir / "tl"
        
        if not game_dir.is_dir():
            log(f"  - 错误: 游戏根目录缺少'game'文件夹。")
            return False
            
        all_names = []
        rpy_files = [p for p in game_dir.rglob("*.rpy")]
        valid_rpy_files = [p for p in rpy_files if not str(p).startswith(str(tl_dir))]

        pattern = re.compile(
            r'''
            ^\s*                                   # 行首可有空格
            (?:define|default)\s+                  # define 或 default
            (?P<var>[A-Za-z_][A-Za-z0-9_]*)       # 变量名
            \s*=\s*                                # 等号
            (?:                                    # 非捕获组，匹配两种情况
                ['"](?P<name1>[^'"]+)['"]         # 直接字符串赋值
                |
                Character\s*\(\s*                  # Character(
                    (?:_\(\s*)?                    # 可选 _(
                    ['"](?P<name2>[^'"]+)['"]     # Character 名字
            )
            ''',
            re.VERBOSE | re.MULTILINE
        )

        for rpy_file in valid_rpy_files:
            try:
                with open(rpy_file, "r", encoding="utf-8") as f:
                    content = f.read()
                    matches = pattern.findall(content)
                    if matches:
                        for match in matches:
                            name = match[1] if match[1] else match[2]
                            if name and name.strip():
                                all_names.append(name.strip())
                        log(f"  - 从 {rpy_file.relative_to(GAME_ROOT)} 提取到 {len(matches)} 个角色名。")
            except UnicodeDecodeError:
                log(f"  - 警告: 无法以utf-8读取文件 {rpy_file.name}，跳过。")
            except Exception as e:
                log(f"  - 错误: 读取文件 {rpy_file.name} 发生错误: {e}")
                
        try:
            with open(POOL_A, "w", encoding="utf-8") as f:
                for name in all_names:
                    f.write(name + "\n")
            log(f"  - 成功将 {len(all_names)} 个角色名写入记忆池A.txt。")
        except Exception as e:
            log(f"  - 错误: 写入记忆池A.txt失败: {e}")
            return False

        log("步骤3 完成。")
        return True

    def step_4():
        log("步骤4: 处理记忆池A内容...")
        try:
            with open(POOL_A, "r", encoding="utf-8") as f:
                lines_A = [l.strip() for l in f.readlines()]
        except FileNotFoundError:
            log("  - 错误: 记忆池A.txt未找到。")
            return False

        unique_lines = list(set([line for line in lines_A if line]))
        log(f"  - 记忆池A去重后剩余 {len(unique_lines)} 个非空行。")

        lines_to_keep_in_A = unique_lines.copy()
        non_alpha_start = [line for line in lines_to_keep_in_A if not re.match(r"^[a-zA-Z]", line)]
        lines_to_keep_in_A = [line for line in lines_to_keep_in_A if re.match(r"^[a-zA-Z]", line)]
        log(f"  - 剪切 {len(non_alpha_start)} 行(开头不是字母)到NameDele.txt。")

        non_upper_start = [line for line in lines_to_keep_in_A if not re.match(r"^[A-Z]", line)]
        lines_to_keep_in_A = [line for line in lines_to_keep_in_A if re.match(r"^[A-Z]", line)]
        log(f"  - 再次剪切 {len(non_upper_start)} 行(首字母不是大写)到NameDele.txt。")

        deleted_lines = non_alpha_start + non_upper_start
        try:
            with open(NAME_DELE, "a", encoding="utf-8") as f:
                for line in deleted_lines:
                    f.write(line + "\n")
                f.write(DEFINER_A)
            log(f"  - 成功将 {len(deleted_lines)} 行内容追加写入NameDele.txt并写入定义符A。")
        except Exception as e:
            log(f"  - 错误: 写入NameDele.txt失败: {e}")

        try:
            with open(POOL_A, "w", encoding="utf-8") as f:
                for line in lines_to_keep_in_A:
                    f.write(line + "\n")
            log(f"  - 记忆池A更新为保留的 {len(lines_to_keep_in_A)} 行内容。")
        except Exception as e:
            log(f"  - 错误: 更新记忆池A.txt失败: {e}")
            return False

        log("步骤4 完成。")
        return True

    def step_5():
        log("步骤5: 复制记忆池A内容到记忆池B...")
        try:
            with open(POOL_A, "r", encoding="utf-8") as a:
                lines_A = [l.strip() for l in a.readlines() if l.strip()]
        except FileNotFoundError:
            log("  - 错误: 记忆池A.txt未找到。")
            return False

        try:
            with open(POOL_B, "w", encoding="utf-8") as b:
                for line in lines_A:
                    b.write(line + "\n")
            log(f"  - 成功将 {len(lines_A)} 行内容复制写入记忆池B.txt。")
        except Exception as e:
            log(f"  - 错误: 写入记忆池B.txt失败: {e}")
            return False

        log("步骤5 完成。")
        return True

    def step_6():
        log("步骤6: 过滤记忆池B内容...")
        try:
            with open(POOL_B, "r", encoding="utf-8") as f:
                lines_B = [l.strip() for l in f.readlines() if l.strip()]
        except FileNotFoundError:
            log("  - 错误: 记忆池B.txt未找到。")
            return False

        filter_pattern = re.compile(r"[\(\)\{\}\[\]\d\\\/#!]")
        to_namedele = []
        to_name_txt_and_C = []
        
        for line in lines_B:
            if filter_pattern.search(line):
                to_namedele.append(line)
            else:
                to_name_txt_and_C.append(line)

        try:
            with open(NAME_DELE, "a", encoding="utf-8") as f:
                for line in to_namedele:
                    f.write(line + "\n")
                f.write(DEFINER_A)
            log(f"  - 成功将 {len(to_namedele)} 行(符合过滤规则)追加写入NameDele.txt并写入定义符A。")
        except Exception as e:
            log(f"  - 错误: 写入NameDele.txt失败: {e}")
            
        try:
            with open(NAME_TXT, "w", encoding="utf-8") as f_name, open(POOL_C, "w", encoding="utf-8") as f_c:
                for line in to_name_txt_and_C:
                    f_name.write(line + "\n")
                    f_c.write(line + "\n")
            log(f"  - 成功将 {len(to_name_txt_and_C)} 行内容写入name.txt和记忆池C.txt。")
        except Exception as e:
            log(f"  - 错误: 写入name.txt或记忆池C.txt失败: {e}")
            return False

        log("步骤6 完成。")
        return True

    def step_7():
        log("步骤7: 遍历tl/翻译文件夹目录提取字符串到记忆池D...")
        schinese_dir = GAME_ROOT / "game" / "tl" / TRANSLATION_DIR
        
        if not schinese_dir.is_dir():
            log(f"  - 错误: 缺少'game/tl/{TRANSLATION_DIR}'文件夹。")
            return False
            
        all_strings = set()
        rpy_files = schinese_dir.rglob("*.rpy")
        string_pattern = re.compile(r'"((?:\\.|[^"\\])*)"')

        for rpy_file in rpy_files:
            try:
                with open(rpy_file, "r", encoding="utf-8") as f:
                    content = f.read()
                    matches = string_pattern.findall(content)
                    if matches:
                        for match in matches:
                            if match.strip():
                                all_strings.add(match)
                        log(f"  - 从 {rpy_file.relative_to(GAME_ROOT)} 提取到 {len(matches)} 个字符串内容。")
            except UnicodeDecodeError:
                log(f"  - 警告: 无法以utf-8读取文件 {rpy_file.name}，跳过。")
            except Exception as e:
                log(f"  - 错误: 读取文件 {rpy_file.name} 发生错误: {e}")
                
        all_strings_list = list(all_strings)
        try:
            with open(POOL_D, "w", encoding="utf-8") as f:
                for s in all_strings_list:
                    f.write(s + "\n")
            log(f"  - 成功将 {len(all_strings_list)} 个去重后的字符串内容写入记忆池D.txt。")
        except Exception as e:
            log(f"  - 错误: 写入记忆池D.txt失败: {e}")
            return False

        log("步骤7 完成。")
        return True

    def step_8():
        log("步骤8: 匹配记忆池C和记忆池D...")
        try:
            with open(POOL_C, "r", encoding="utf-8") as a, open(POOL_D, "r", encoding="utf-8") as b:
                lines_C = [l.strip() for l in a.readlines() if l.strip()]
                lines_D = set([l.strip() for l in b.readlines() if l.strip()])
        except FileNotFoundError as e:
            log(f"  - 错误: 读取记忆池C.txt或记忆池D.txt失败: {e}")
            return False

        matched_count = 0
        unmatched_count = 0
        
        try:
            with open(POOL_E, "w", encoding="utf-8") as e, open(NAME_DELE, "a", encoding="utf-8") as dele:
                for line in lines_C:
                    if line in lines_D:
                        dele.write(line + "\n\n")
                        matched_count += 1
                    else:
                        e.write(line + "\n")

                    print("✗ 自定义字体选择失败，请重新选择")
            else:
                print("无效选择，请重新输入")

        if font_choice in ["1", "2"] and selected_font in PACKED_FONTS:
            packed_fonts = PACKED_FONTS
            print(f"[5] 成功加载 PACKED_FONTS，共 {len(packed_fonts)} 个字体")

            try:
                font_name = selected_font
                encoded_data = packed_fonts[font_name]
                print(f"[6] 正在处理字体: {font_name}")
                compressed_str = "".join(encoded_data.split())
                compressed_bytes = base64.b64decode(compressed_str)
                font_data = gzip.decompress(compressed_bytes)

                font_path = os.path.join(tl_dir, font_name)

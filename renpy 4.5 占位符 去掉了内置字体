def script_10():
    """10.插入中文设置模块.py"""
    print("=== 执行: 10.插入中文设置模块.py ===")
    ensure_root_dir()
    
    import os
    
    game_root = ROOT_DIR
    GAME_DIR = os.path.join(game_root, "game")
    
    def log(msg):
        print(f"[INFO] {msg}")
    
    def read_lines(filepath):
        with open(filepath, "r", encoding="utf-8") as f:
            return f.readlines()
    
    def write_lines(filepath, lines):
        with open(filepath, "w", encoding="utf-8") as f:
            f.writelines(lines)
        log(f"已写入文件: {filepath}, 共 {len(lines)} 行")
    
    def find_radio_vbox_structure(lines):
        for i, line in enumerate(lines):
            if 'vbox:' in line and not line.strip().startswith('#'):
                if i + 1 < len(lines) and '    style_prefix "radio"' in lines[i + 1]:
                    log(f"找到 radio vbox 结构，行号: {i}")
                    return i
        return None
    
    def find_vbox_end(lines, start_index):
        vbox_indent = len(lines[start_index]) - len(lines[start_index].lstrip())
        
        i = start_index + 1
        while i < len(lines):
            current_line = lines[i]
            current_indent = len(current_line) - len(current_line.lstrip())
            if current_line.strip() and current_indent <= vbox_indent:
                return i
            i += 1
        
        return len(lines)
    
    def insert_radio_code(lines, vbox_index, language_option):
        vbox_indent = len(lines[vbox_index]) - len(lines[vbox_index].lstrip())
        vbox_end_index = find_vbox_end(lines, vbox_index)
        log(f"vbox 代码块结束位置: {vbox_end_index}")
        
        radio_code = [
            ' ' * vbox_indent + "vbox:\n",
            ' ' * (vbox_indent + 4) + 'style_prefix "radio"\n',
            ' ' * (vbox_indent + 4) + 'label _("Language")\n',
            ' ' * (vbox_indent + 4) + 'textbutton _("English") action Language(None)\n',
            ' ' * (vbox_indent + 4) + f'textbutton _("中文") action Language("{language_option}")\n'
        ]
        
        for j, code_line in enumerate(radio_code):
            lines.insert(vbox_end_index + j, code_line)
        
        lines.insert(vbox_end_index + len(radio_code), "\n")
        
        log(f"在行号 {vbox_end_index} 插入语言选择代码，并在代码后添加空行")
        return lines
    
    def insert_language_define(filepath, language_option):
        lines = read_lines(filepath)
        
        first_define_index = -1
        for i, line in enumerate(lines):
            stripped_line = line.lstrip()
            if stripped_line.startswith('define ') and not line.startswith(' ') and not line.startswith('\t'):
                first_define_index = i
                log(f"找到第一个 define 行，行号: {i}, 内容: {line.strip()}")
                break
        
        if first_define_index == -1:
            log("未找到以 define 开头的行，在第一行插入语言定义")
            lines.insert(0, f'define config.language = "{language_option}"\n')
            lines.insert(1, "\n")
        else:
            insert_index = first_define_index + 1
            lines.insert(insert_index, f'define config.language = "{language_option}"\n')
            log(f"在第一个 define 行下方插入语言定义，插入位置: {insert_index}")
        
        write_lines(filepath, lines)
        log(f"在 options.rpy 中插入 define config.language = '{language_option}'")
    
    def find_rpy_files(exclude_dirs=None):
        if exclude_dirs is None:
            exclude_dirs = ['tl']
        
        rpy_files = []
        for root, dirs, files in os.walk(GAME_DIR):
            root_rel = os.path.relpath(root, GAME_DIR)
            if any(excluded in root_rel for excluded in exclude_dirs):
                continue
            
            for file in files:
                if file.endswith('.rpy'):
                    rpy_files.append(os.path.join(root, file))
        
        return rpy_files
    
    def select_language_option():
        print("\n请选择语言选项：")
        print("1: schinese")
        print("2: chinese") 
        print("3: 自定义")
        
        while True:
            choice = input("请输入选择 (1/2/3): ").strip()
            if choice == "1":
                return "schinese"
            elif choice == "2":
                return "chinese"
            elif choice == "3":
                custom_lang = input("请输入自定义语言选项: ").strip()
                if custom_lang:
                    return custom_lang
                else:
                    print("自定义语言不能为空，请重新输入")
            else:
                print("无效选择，请重新输入")
    
    def main():
        log("脚本开始执行")
        
        language_option = select_language_option()
        log(f"选择的语言选项: {language_option}")
        
        log("正在查找 screens.rpy 文件...")
        screens_files = [f for f in find_rpy_files() if os.path.basename(f) == 'screens.rpy']
        
        if not screens_files:
            log("未找到 screens.rpy 文件，跳转到 options.rpy 处理")
            process_options_rpy(language_option)
            return
        
        screens_path = screens_files[0]
        log(f"直接处理 screens.rpy 文件: {screens_path}")
        
        lines = read_lines(screens_path)
        radio_vbox_index = find_radio_vbox_structure(lines)
        
        if radio_vbox_index is not None:
            log("找到 radio vbox 结构，准备插入语言选择代码")
            lines = insert_radio_code(lines, radio_vbox_index, language_option)
            write_lines(screens_path, lines)
            log("成功在 screens.rpy 中插入语言选择代码")
        else:
            log("未找到 radio vbox 结构，处理 options.rpy")
            process_options_rpy(language_option)
    
    def process_options_rpy(language_option):
        log("开始处理 options.rpy 文件")
        
        options_files = [f for f in find_rpy_files() if os.path.basename(f) == 'options.rpy']
        
        if not options_files:
            log("未找到 options.rpy 文件")
            return
        
        options_path = options_files[0]
        log(f"直接处理 options.rpy 文件: {options_path}")
        
        insert_language_define(options_path, language_option)
        log("options.rpy 处理完成")
    
    main()
    
    log("脚本执行完毕")
    wait_for_return()

def script_11():
    """11.生成style字体控制模块2.3.py"""
    print("=== 执行: 11.生成style字体控制模块2.3.py ===")
    ensure_root_dir()
    if not ensure_translation_dir():
        wait_for_return()
        return
    
    import os
    import gzip
    import base64
    import tkinter as tk
    from tkinter import filedialog

    PACKED_FONTS = {
        "Arial-Unicode-Regular.ttf": (
            """H4sIAJYc7mgAALy......"""
        ),
        "DejaVuSans.ttf": (
            """H4sIAJYc7mgAALy......"""
        ),
    }
    
    def select_custom_font():
        root = tk.Tk()
        root.withdraw()
        
        filetypes = [
            ("字体文件", "*.ttf *.otf *.ttc"),
            ("TrueType字体", "*.ttf"),
            ("OpenType字体", "*.otf"),
            ("所有文件", "*.*")
        ]
        
        font_path = filedialog.askopenfilename(
            title="请选择字体文件",
            filetypes=filetypes
        )
        
        root.destroy()
        
        if font_path:
            font_filename = os.path.basename(font_path)
            tl_dir = get_tl_path()
            dest_path = os.path.join(tl_dir, font_filename)
            
            try:
                with open(font_path, "rb") as src_file:
                    with open(dest_path, "wb") as dest_file:
                        dest_file.write(src_file.read())
                print(f"✓ 已复制字体文件: {font_filename}")
                return font_filename
            except Exception as e:
                print(f"✗ 复制字体文件失败: {e}")
                return None
        else:
            print("✗ 未选择字体文件")
            return None

    def main():
        print("=== 游戏字体安装脚本 ===\n")

        game_root = ROOT_DIR
        print(f"[1] 游戏根目录: {game_root}")

        game_dir = os.path.join(game_root, "game")
        if not os.path.exists(game_dir):
            print("错误：未找到 game 文件夹！")
            wait_for_return()
            return

        tl_dir = get_tl_path()
        if not os.path.exists(tl_dir):
            print(f"错误：未找到 game/tl/{TRANSLATION_DIR} 文件夹！")
            wait_for_return()
            return

        print("[2] 游戏目录结构检查通过")
        print(f"[3] 字体将直接解压到: {tl_dir}")

        selected_font = None
        
        while selected_font is None:
            print("\n[4] 请选择要使用的字体：")
            print("    1. Arial-Unicode-Regular.ttf")
            print("    2. DejaVuSans.ttf")
            print("    3. 自己选一个喜欢的")
            
            font_choice = input("请输入选择 (1, 2 或 3): ").strip()
            
            if font_choice == "1":
                selected_font = "Arial-Unicode-Regular.ttf"
                print(f"✓ 已选择字体: {selected_font}")
            elif font_choice == "2":
                selected_font = "DejaVuSans.ttf"
                print(f"✓ 已选择字体: {selected_font}")
            elif font_choice == "3":
                print("正在打开文件选择对话框...")
                custom_font = select_custom_font()

    import os
    import shutil

    def main():
        print("=== 🎮 RPY 文件处理脚本开始执行 ===\n")

        root_dir = ROOT_DIR
        print(f"【1】根目录路径：{root_dir}")

        schinese_dir = os.path.join(root_dir, "schinese")
        if not os.path.exists(schinese_dir):
            os.makedirs(schinese_dir)
            print(f"【2】已创建目录：{schinese_dir}")
        else:
            print(f"【2】目录已存在：{schinese_dir}")

        src_dir = get_tl_path()
        if not os.path.exists(src_dir):
            print(f"❌ 未找到源路径：{src_dir}")
            return

        print(f"\n【3】开始复制文件：{src_dir} → {schinese_dir}")
        for file_name in os.listdir(src_dir):
            if file_name.endswith(".rpy"):
                src_file = os.path.join(src_dir, file_name)
                dst_file = os.path.join(schinese_dir, file_name)
                shutil.copy2(src_file, dst_file)
                print(f"✅ 已复制：{file_name}")
        print("🎯 所有 rpy 文件复制完成。\n")

        result_file = os.path.join(root_dir, "result.txt")
        if not os.path.exists(result_file):
            print(f"❌ 未找到规则文件：{result_file}")
            return

        print("【4】开始读取替换规则：")
        replace_rules = []
        with open(result_file, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("\t")
                if len(parts) < 2:
                    parts = line.split("  ")
                if len(parts) < 2:
                    parts = line.split(" ")
                if len(parts) >= 2:
                    key = parts[0].strip()
                    value = parts[-1].strip()
                    replace_rules.append((key, value))
                    print(f"   🔁 规则：'{key}' → '{value}'")

        if not replace_rules:
            print("⚠️ 未读取到任何替换规则，请检查 result.txt 格式。")
            return

        print("\n【5】开始处理 schinese 文件夹内的 rpy 文件内容：")
        for file_name in os.listdir(schinese_dir):
            if not file_name.endswith(".rpy"):
                continue
            file_path = os.path.join(schinese_dir, file_name)
            print(f"➡️ 正在处理：{file_name}")

            with open(file_path, "r", encoding="utf-8") as f:
                content = f.read()

            for old, new in replace_rules:
                if old in content:
                    count = content.count(old)
                    content = content.replace(old, new)
                    print(f"   ✳️ 替换 {count} 次：'{old}' → '{new}'")

            with open(file_path, "w", encoding="utf-8") as f:
                f.write(content)

            print(f"💾 已保存修改：{file_name}\n")

        print("✅ 所有替换操作完成！")
        print("\n=== 🎉 任务执行完毕 ===")
        wait_for_return()

    main()

def script_18():
    """18.规则还原.py"""
    print("=== 执行: 18.规则还原.py ===")
    ensure_root_dir()
    
    import os

    def main():
        root_dir = ROOT_DIR
        schinese_dir = os.path.join(root_dir, "schinese")
        result_file = os.path.join(root_dir, "result.txt")

        if not os.path.exists(schinese_dir):
            print(f"❌ 错误：schinese文件夹不存在: {schinese_dir}")
            print("请先运行功能17生成schinese文件夹")
            wait_for_return()
            return

        if not os.path.exists(result_file):
            print(f"❌ 错误：result.txt文件不存在: {result_file}")
            print("请先运行功能02生成替换规则")
            wait_for_return()
            return

        replace_rules = []
        try:
            with open(result_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    parts = line.split(None, 1)
                    if len(parts) != 2:
                        print(f"跳过格式不正确的行: {line}")
                        continue
                    replace_content, match_content = parts
                    replace_rules.append((match_content, replace_content))
        except Exception as e:
            print(f"❌ 读取result.txt文件时出错: {e}")
            wait_for_return()
            return

        print(f"共读取 {len(replace_rules)} 条替换规则")

        rpy_files = []
        try:
            for root, dirs, files in os.walk(schinese_dir):
                for file in files:
                    if file.endswith(".rpy"):
                        rpy_files.append(os.path.join(root, file))
        except Exception as e:
            print(f"❌ 遍历schinese文件夹时出错: {e}")
            wait_for_return()
            return

        if not rpy_files:
            print("❌ 在schinese文件夹中未找到任何rpy文件")
            wait_for_return()
            return

        print(f"找到 {len(rpy_files)} 个 rpy 文件需要处理")

        processed_count = 0
        for rpy_file in rpy_files:
            print(f"\n处理文件: {os.path.basename(rpy_file)}")
            try:
                with open(rpy_file, "r", encoding="utf-8") as f:
                    lines = f.readlines()
            except Exception as e:
                print(f"❌ 读取文件失败: {rpy_file}, 错误: {e}")
                continue

            changed = False
            new_lines = []
            for i, line in enumerate(lines, start=1):
                original_line = line
                for match_content, replace_content in replace_rules:
                    if match_content in line:
                        line = line.replace(match_content, replace_content)
                        changed = True
                        print(f"  行 {i}: '{match_content}' -> '{replace_content}'")
                new_lines.append(line)

            if changed:
                try:
                    with open(rpy_file, "w", encoding="utf-8") as f:
                        f.writelines(new_lines)
                    print(f"✅ 文件已保存: {os.path.basename(rpy_file)}")
                    processed_count += 1
                except Exception as e:
                    print(f"❌ 保存文件失败: {rpy_file}, 错误: {e}")
            else:
                print("   无内容需要替换，文件保持不变")

        print(f"\n✅ 全部文件处理完成！成功处理 {processed_count}/{len(rpy_files)} 个文件")
        wait_for_return()

    main()


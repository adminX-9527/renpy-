    found_archive = False
    found_classify = False

    # 模式
    pattern_archive = re.compile(r'build\.archive\(\s*["\']scripts["\']\s*,\s*["\']all["\']\s*\)')
    pattern_classify = re.compile(r'build\.classify\(\s*["\']game/[^"\']+["\']\s*,\s*["\'][^"\']+["\']\s*\)')

    for rpy_path in rpy_files:
        with open(rpy_path, "r", encoding="utf-8", errors="ignore") as f:

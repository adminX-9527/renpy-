    # --- 从功能模块1导入的提取规则 ---
    def etx_unescape_string(s):
        """处理字符串中的转义序列"""
        # 已移除转义处理以保持原文不变
        return s

    def etx_is_valid_name(name):
        """检查名称是否有效，过滤掉不需要的条目（人名专用过滤规则）。"""
        FILE_EXTENSIONS = (
            '.webp', '.webm', '.ttf', '.otf', '.jpg', '.png', '.gif', '.jpeg', 
            '.avif', '.mp3', '.wav', '.wmv', '.mp4', '.psd', '.ogg'
        )
        if name.lower().endswith(FILE_EXTENSIONS):
            return False
        if '/' in name or '\\' in name:
            return False
        if name.isdigit():
            return False
        if (name.startswith('[') and name.endswith(']')) or \
           (name.startswith('{') and name.endswith('}')):
            return False
        if name.isascii() and name == name.lower():
            return False
        return True

    def etx_extract_character_names(filename, script_dir):
        """从单个 .rpy 文件中提取角色名称，并返回 (名称, 路径, 行号) 的元组列表"""
        pattern_char = re.compile(
            r'^define\s+\w+\s*=\s*Character\s*\(\s*'
            r'(?:_\s*\()?'
            r'''(['"])(.*?)\1'''
            r'(?:\s*\)\s*)?'
            r'.*?\)',
            re.IGNORECASE | re.DOTALL
        )
        pattern_direct = re.compile(
            r'^define\s+\w+\s*=\s*'
            r'''(['"])(.*?)\1''',
            re.IGNORECASE
        )
        names_data = []
        seen = set()
        relative_path = str(Path(filename).relative_to(PROJECT_ROOT))
        try:
            with open(filename, 'r', encoding='utf-8', errors='ignore') as f:
                for i, line in enumerate(f):
                    line_num = i + 1
                    line_stripped = line.strip()
                    if not line_stripped.startswith(('define', 'Define')):
                        continue
                    
                    match_char = pattern_char.search(line_stripped)
                    if match_char:
                        name = match_char.group(2).strip()
                        # 保持原文，不做反斜杠转义处理
                        if name and name not in seen:
                            seen.add(name)
                            names_data.append((name, relative_path, line_num))
                        continue

                    match_direct = pattern_direct.search(line_stripped)
                    if match_direct:
                        name = match_direct.group(2).strip()
                        # 保持原文，不做反斜杠转义处理
                        if name and name not in seen:
                            seen.add(name)
                            names_data.append((name, relative_path, line_num))
        except Exception as e:
            print(f"读取文件 {filename} 时出错: {str(e)}")
        return names_data

    def etx_filter_extracted_strings(string_data):
        """
        对提取的字符串数据列表进行过滤，并返回被删除的字符串列表。
        每个元素是一个元组 (string, path, line)。
        """
        filtered_list = []
        deleted_list = [] # 用于存放被删除的字符串文本

        file_extensions = ('.mp3', '.png', '.jpg', '.jpeg', '.ogg', '.wav', '.webp', '.gif', '.avi', '.mp4', '.mov', '.webm', '.flv', '.wmv')

        for item in string_data:
            string, path, line = item
            original_string = string

            if not string or string.strip() == '':
                deleted_list.append(original_string)
                continue

            is_file_path = False
            lower_string = string.lower()
            for ext in file_extensions:
                if ext in lower_string:
                    is_file_path = True
                    break
            if is_file_path:
                deleted_list.append(original_string)
                continue

            temp_string = re.sub(r'\{.*?\}', '', string)
            temp_string = re.sub(r'\[.*?\]', '', temp_string)
            if not re.search(r'[a-zA-Z]', temp_string):
                deleted_list.append(original_string)
                continue

            if string.isdigit():
                deleted_list.append(original_string)
                continue
                
            if len(string) == 1 and 'A' <= string <= 'Z':
                deleted_list.append(original_string)
                continue

            if (string.startswith('[') and string.endswith(']')) or \
               (string.startswith('{') and string.endswith('}')):
                if '{/' in string or ' ' in string:
                    pass
                else:
                    deleted_list.append(original_string)
                    continue

            if string.startswith('#'):
                deleted_list.append(original_string)
                continue

            has_uppercase = any(char.isupper() for char in string)

            if not has_uppercase:
                deleted_list.append(original_string)
                continue

            if string and string[0].islower():
                deleted_list.append(original_string)
                continue

            filtered_list.append(item)

        return filtered_list, deleted_list

    def etx_extract_strings_from_rpy(file_path):
        """从rpy文件中提取字符串及其位置信息(string, path, line)"""
        text_data = []
        variable_data = []
        replace_data = []
        
        relative_path = str(Path(file_path).relative_to(PROJECT_ROOT))

        try:
            with open(file_path, 'r', encoding='utf-8', errors='replace') as f:
                content = f.read()

                def get_line_number(pos):
                    return content.count('\n', 0, pos) + 1

                text_patterns = [
                    r'\btext\s+(["\'])((?:\\\1|.)*?)\1\s*:',
                    r'\b(text|textbutton|show\s+text)\s+(["\'])((?:\\\2|.)*?)\2',
                    r'renpy\.input\s*\(\s*(["\'])((?:\\\1|.)*?)\1'
                ]
                for pattern in text_patterns:
                    for match in re.finditer(pattern, content, re.IGNORECASE | re.MULTILINE):
                        if pattern == text_patterns[1]:
                            string = etx_unescape_string(match.group(3))
                        else:
                            string = etx_unescape_string(match.group(2))
                        
                        start_pos = match.start()
                        preceding_text = content[content.rfind('\n', 0, start_pos) + 1 : start_pos]
                        if not re.search(r'_\s*\(\s*$', preceding_text.strip()):
                            line_num = get_line_number(start_pos)
                            text_data.append((string, relative_path, line_num))

                variable_keywords = [
                    r'(default\s+\w+\s*=\s*)',
                    r'(define\s+\w+\s*=\s*)',
                    r'(\$\s*\w+\s*=\s*)'
                ]
                for i, line in enumerate(content.split('\n')):
                    line_num = i + 1
                    for keyword_pattern in variable_keywords:
                        match_keyword = re.search(keyword_pattern, line)
                        if match_keyword and "Character" not in line and "renpy.input" not in line:
                            if not re.search(r'=\s*_\s*\(', line):
                                str_matches = re.finditer(r'(["\'])((?:\\\1|.)*?)\1', line)
                                for match in str_matches:
                                    string = etx_unescape_string(match.group(2))
                                    variable_data.append((string, relative_path, line_num))
                            break

                tooltip_pattern = r'\btooltip\s*\(\s*(["\'])((?:\\\1|.)*?)\1'
                for match in re.finditer(tooltip_pattern, content, re.IGNORECASE):
                    string = etx_unescape_string(match.group(2))
                    start_pos = match.start()
                    preceding_text = content[content.rfind('\n', 0, start_pos) + 1 : start_pos]
                    if not re.search(r'_\s*\(\s*$', preceding_text.strip()):
                        line_num = get_line_number(start_pos)
                        replace_data.append((string, relative_path, line_num))

                lines = content.split('\n')
                for i, line in enumerate(lines):
                    line_num = i + 1
                    
                    if re.search(r'^\s*call\s+.*\s+from\b', line):
                        for match in re.finditer(r'(["\'])((?:\\\1|.)*?)\1', line):
                            if not re.search(r'_\s*\(\s*$', line[:match.start()].rstrip()):
                                string = etx_unescape_string(match.group(2))
                                if string: text_data.append((string, relative_path, line_num))

                    if re.search(r'^\s*call\s+(screen\s+phone_reply|message_start|reply_message|message)\b', line):
                        for match in re.finditer(r'(["\'])((?:\\\1|.)*?)\1', line):
                            if not re.search(r'_\s*\(\s*$', line[:match.start()].rstrip()):
                                string = etx_unescape_string(match.group(2))
                                if string:
                                    item = (string, relative_path, line_num)
                                    text_data.append(item)
                                    replace_data.append(item)
                    
                    if re.search(r'^\s*\$\s*csay\s*\(', line):
                        for match in re.finditer(r'(["\'])((?:\\\1|.)*?)\1', line):
                            if not re.search(r'_\s*\(\s*$', line[:match.start()].rstrip()):
                                string = etx_unescape_string(match.group(2))
                                if string: text_data.append((string, relative_path, line_num))
                    
                    if re.search(r'^\s*\$\s*renpy\.notify\s*\(', line):
                        for match in re.finditer(r'(["\'])((?:\\\1|.)*?)\1', line):
                            if not re.search(r'_\s*\(\s*$', line[:match.start()].rstrip()):
                                string = etx_unescape_string(match.group(2))
                                if string: text_data.append((string, relative_path, line_num))
                    
                    if re.search(r'^\s*show\s+screen\s+my_notify\s*\(', line):
                        for match in re.finditer(r'(["\'])((?:\\\1|.)*?)\1', line):
                            if not re.search(r'_\s*\(\s*$', line[:match.start()].rstrip()):
                                string = etx_unescape_string(match.group(2))
                                if string: text_data.append((string, relative_path, line_num))

                    line_stripped = line.lstrip()
                    if re.match(r'^[a-zA-Z_]\w*\s*=\s*f?["\']', line_stripped) and not re.match(r'^(default|define|\$|image|transform|style|screen|menu)', line_stripped):
                        if not re.search(r'=\s*_\s*\(', line):
                            for match in re.finditer(r'f?(["\'])((?:\\\1|.)*?)\1', line):
                                string = etx_unescape_string(match.group(2))
                                if string: variable_data.append((string, relative_path, line_num))
                    
                    if re.search(r'^\s*\$\s*(StreamAdd|MessageCommit|StreamUpdate)\s*\(', line):
                        for match in re.finditer(r'(["\'])((?:\\\1|.)*?)\1', line):
                            if not re.search(r'_\s*\(\s*$', line[:match.start()].rstrip()):
                                string = etx_unescape_string(match.group(2))
                                if string: text_data.append((string, relative_path, line_num))

                choice_option_pattern = r'ChoiceOption\s*\(\s*(["\'])((?:\\\1|.)*?)\1'
                for match in re.finditer(choice_option_pattern, content, re.IGNORECASE):
                    start_pos = match.start()
                    context_start = content.rfind('ChoiceOption', 0, start_pos)
                    preceding_text = content[content.rfind('\n', 0, context_start)+1 : context_start]
                    if not re.search(r'_\s*\(\s*$', preceding_text.strip()):
                        string = etx_unescape_string(match.group(2))
                        if string:
                            line_num = get_line_number(start_pos)
                            text_data.append((string, relative_path, line_num))

        except Exception as e:
            print(f"处理文件 {file_path} 时出错: {e}")

        seen = set()
        unique_text = []
        for item in text_data:
            if item[0] not in seen:
                seen.add(item[0])
                unique_text.append(item)
        
        seen = set()
        unique_variable = []
        for item in variable_data:
            if item[0] not in seen:
                seen.add(item[0])
                unique_variable.append(item)
                
        seen = set()
        unique_replace = []
        for item in replace_data:
            if item[0] not in seen:
                seen.add(item[0])
                unique_replace.append(item)
                
        return unique_text, unique_variable, unique_replace

    def etx_extract_old_new_translations(file_path):
        """从翻译文件中提取 old/new 翻译对"""
        old_strings = []
        new_strings = []
        try:
            with open(file_path, 'r', encoding='utf-8', errors='replace') as f:
                content = f.read()
                old_matches = re.findall(r'old\s+(["\'])((?:\\\1|.)*?)\1', content)
                new_matches = re.findall(r'new\s+(["\'])((?:\\\1|.)*?)\1', content)
                for _, old_string in old_matches:
                    old_strings.append(etx_unescape_string(old_string))
                for _, new_string in new_matches:
                    new_strings.append(etx_unescape_string(new_string))
        except Exception as e:
            print(f"处理翻译文件 {file_path} 时出错: {e}")
        min_length = min(len(old_strings), len(new_strings))
        return old_strings[:min_length], new_strings[:min_length]

    def etx_scan_directory_for_rpy(directory, exclude_dirs=None):
        """扫描目录下的所有.rpy文件"""
        if exclude_dirs is None:
            exclude_dirs = []
        rpy_files = []
        try:
            for root, dirs, files in os.walk(directory):
                exclude_paths = [os.path.normpath(d) for d in exclude_dirs]
                dirs[:] = [d for d in dirs if os.path.normpath(os.path.join(root, d)) not in exclude_paths]
                for file in files:
                    if file.endswith('.rpy'):
                        rpy_files.append(os.path.normpath(os.path.join(root, file)))
        except Exception as e:
            print(f"扫描目录 {directory} 时出错: {e}")
        return rpy_files

    # --- 核心函数：规则1: rpy文件字符串提取 (使用功能模块1的完整规则) ---
    def extract_rpy_strings(file_path):
        """
        从 .rpy 文件中提取四类字符串：人名, 文本, 变量, 替换。
        使用功能模块1的完整提取规则。
        返回格式：[人名列表, 文本列表, 变量列表, 替换列表]
        每个列表元素格式：(string, relative_path, line_number)
        """
        # 提取角色名
        name_strings = etx_extract_character_names(file_path, PROJECT_ROOT)
        
        # 提取其他文本类型
        text_strings, variable_strings, replace_strings = etx_extract_strings_from_rpy(file_path)
        
        # 合并所有提取的字符串
        all_strings = name_strings + text_strings + variable_strings + replace_strings
        
        return [all_strings, text_strings, variable_strings, replace_strings]

    # --- 核心函数：规则4: 统一字符串过滤 (使用功能模块1的筛选规则) ---
    def shared_filter_strings(strings_with_info):
        """
        统一的字符串过滤函数，使用功能模块1的筛选规则。
        (strings_with_info 格式: [(string, file_path, line_number), ...])
        """
        print("\n[步骤4] 正在执行统一字符串筛选...")
        
        # 使用功能模块1的筛选函数
        filtered_list, deleted_list = etx_filter_extracted_strings(strings_with_info)
        
        print(f"    筛选完成。原始: {len(strings_with_info)} 条, 过滤后: {len(filtered_list)} 条, 移除: {len(deleted_list)} 条。")
        
        return filtered_list, deleted_list

    # --- 辅助函数：规则5: 写入记忆池A ---
    def copy_first_column_d_to_a():
        """

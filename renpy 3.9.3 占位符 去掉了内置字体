    import time

    # 1. 定义文件路径和目标路径
    ROOT_DIR_LOCAL = ROOT_DIR # 脚本所在目录即为游戏根目录
    TRANSLATE_PATH = os.path.join(ROOT_DIR_LOCAL, 'game', 'tl', 'schinese', 'translate.rpy')
    REPLACE_FILENAME = 'replace.rpy'
    TEMP_REPLACE_PATH = os.path.join(ROOT_DIR_LOCAL, REPLACE_FILENAME) # 临时生成在根目录
    FINAL_REPLACE_DIR = os.path.join(ROOT_DIR_LOCAL, 'game', 'tl', 'schinese') # 最终目标目录

    def generate_replace_rpy():
        print(f"--- 步骤 1: 检查文件路径 ---")
        print(f"游戏根目录: {ROOT_DIR_LOCAL}")
        print(f"源文件路径: {TRANSLATE_PATH}")
        print(f"目标文件夹: {FINAL_REPLACE_DIR}")

        # 检查源文件是否存在
        if not os.path.exists(TRANSLATE_PATH):
            print(f"\n错误：未找到源文件 {TRANSLATE_PATH}")
            print("请确保脚本位于游戏根目录下，并且文件路径 'game/tl/schinese/translate.rpy' 正确无误。")
            return

        print(f"\n--- 步骤 2: 读取 {TRANSLATE_PATH} 并提取替换内容 ---")
        
        # 2. 正则表达式模式：匹配 old "..." 和 new "..." 模式
        # 注意：使用非贪婪匹配 (.*?) 以避免匹配到多个字符串块。
        pattern = re.compile(r'^\s*old\s+"(.*?)"\s*$\s*^\s*new\s+"(.*?)"\s*$', re.MULTILINE)
        
        try:
            with open(TRANSLATE_PATH, 'r', encoding='utf-8') as f:
                content = f.read()
        except Exception as e:
            print(f"\n错误：读取文件时发生异常: {e}")
            return

        matches = pattern.findall(content)
        
        if not matches:
            print("\n警告：未在 translate.rpy 中找到任何 'old \"...\"' / 'new \"...\"' 匹配对。")
            return

        print(f"成功找到 {len(matches)} 组翻译对。")
        print(f"\n--- 步骤 3: 构造 replace.rpy 文件内容 ---")

        # 3. 构造 replace.rpy 文件的头部和函数体
        header = (
            'init python:\n'
            '\n'
            '    import re\n'
            '    def replace_text(t):\n'
            '        ### schinese\n'
            '        if _preferences.language == "schinese":\n'
            '\n'
        )
        
        replace_lines = []
        # 转换格式： old "原内容" / new "翻译" -> t = t.replace("原内容" , "翻译")
        for original, translated in matches:
            # Ren'Py 翻译文件中的 old/new 内容是 Unicode 字符串，
            # 在 Python 中写入时，将双引号转义为 \"
            # 注意：这里的 original 和 translated 不再包含前后的空格，因为正则捕获组已排除。
            # 如果您的 translate.rpy 中 old/new 内部包含换行符或其他复杂字符，可能需要调整正则。
            replace_line = f'            t = t.replace("{original}" , "{translated}")'
            replace_lines.append(replace_line)

        footer = (
            '\n'
            '        return t\n'
            '    config.replace_text = replace_text\n'
        )
        
        final_content = header + '\n'.join(replace_lines) + footer

        # 4. 生成 replace.rpy 文件到根目录
        try:
            with open(TEMP_REPLACE_PATH, 'w', encoding='utf-8') as f:
                f.write(final_content)
            print(f"\n成功生成临时文件: {TEMP_REPLACE_PATH}")

        except Exception as e:
            print(f"\n错误：写入文件时发生异常: {e}")
            return

        # 5. 剪切文件到目标目录
        print(f"\n--- 步骤 4: 剪切 {REPLACE_FILENAME} 到目标目录 ---")
        
        # 确保目标目录存在
        if not os.path.exists(FINAL_REPLACE_DIR):
            os.makedirs(FINAL_REPLACE_DIR)
            print(f"创建了目标目录: {FINAL_REPLACE_DIR}")
            
        final_path = os.path.join(FINAL_REPLACE_DIR, REPLACE_FILENAME)
        
        try:
            shutil.move(TEMP_REPLACE_PATH, final_path)
            print(f"成功将文件移动到: {final_path}")
            print("\n--- 脚本执行完毕 ---")
            print("\n**请按任意键手动关闭此窗口。**")
            
        except Exception as e:
            print(f"\n错误：移动文件时发生异常: {e}")
            print(f"请检查目标文件夹权限或手动将 {TEMP_REPLACE_PATH} 剪切到 {FINAL_REPLACE_DIR} 中。")
            print("\n--- 脚本执行完毕 (有错误) ---")
            print("\n**请按任意键手动关闭此窗口。**")

    generate_replace_rpy()
    # 保持执行面板不关闭 (需要用户手动关闭)
    input("按回车键返回主菜单...")


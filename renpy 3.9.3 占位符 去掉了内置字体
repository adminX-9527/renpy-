def script_01():
    """01.删除 rpyc - 原封不动"""
    print("=== 执行: 01.删除 rpyc ===")
    
    import os

    # --------------------------
    # 1. 脚本所在目录即为游戏根目录
    # --------------------------
    root_dir = ROOT_DIR
    game_dir = os.path.join(root_dir, "game")

    # --------------------------
    # 2. 遍历找到 game 目录下（包括子文件夹）的全部 rpyc 文件
    # --------------------------
    rpyc_files = []

    for dirpath, dirnames, filenames in os.walk(game_dir):
        for file in filenames:
            if file.endswith(".rpyc"):
                rpyc_files.append(os.path.join(dirpath, file))

    # --------------------------
    # 3. 删除全部找到的 rpyc 文件
    # --------------------------
    if rpyc_files:
        print("开始删除 rpyc 文件：\n")
        for file_path in rpyc_files:
            try:
                os.remove(file_path)
                print(f"已删除: {file_path}")
            except Exception as e:
                print(f"删除失败: {file_path}，原因: {e}")
    else:
        print("未找到任何 rpyc 文件。")

    # --------------------------
    # 4. 保持执行面板不关闭
    # --------------------------
    print("\n全部操作完成。")
    input("请按回车键返回主菜单...")

def script_02():
    """02.生成替换规则 - 修改版：使用<<占位_数字>>格式"""
    print("=== 执行: 02.生成替换规则 ===")
    
    import os
    import re

    # -------------------- 配置 --------------------
    # 游戏根目录（脚本所在目录即为游戏根目录）
    ROOT_DIR_LOCAL = ROOT_DIR

    # 输出文件路径
    MEMORY_A_PATH = os.path.join(ROOT_DIR_LOCAL, "记忆池A.txt")
    MEMORY_B_PATH = os.path.join(ROOT_DIR_LOCAL, "记忆池B.txt")
    RESULT_PATH = os.path.join(ROOT_DIR_LOCAL, "result.txt")

    # 替换为 <<占位_数字>> 格式
    def generate_placeholder(index):
        """生成占位符格式：<<占位_数字>>"""
        return f"<<占位_{index}>>"

    # -------------------- 步骤 1：遍历 rpy 文件并提取文本 --------------------
    tl_dir = os.path.join(ROOT_DIR_LOCAL, "game", "tl", "schinese")
    # 正则：匹配双引号内的任意内容，支持转义引号
    pattern = r'"((?:\\.|[^"\\])*)"'

    memory_a_lines = []

    print("开始遍历 rpy 文件并提取引号内字符串...")
    file_count = 0
    for root, dirs, files in os.walk(tl_dir):
        for file in files:
            if file.endswith(".rpy"):
                file_count += 1
                file_path = os.path.join(root, file)
                # 使用 errors='ignore' 以避免因部分文件编码问题中断
                with open(file_path, "r", encoding="utf-8", errors='ignore') as f:
                    content = f.read()
                    matches = re.findall(pattern, content)
                    memory_a_lines.extend(matches)

    # 写入记忆池A
    with open(MEMORY_A_PATH, "w", encoding="utf-8") as f:
        for line in memory_a_lines:
            f.write(line + "\n")
    print(f"记忆池A生成完成，{len(memory_a_lines)}条记录")

    # -------------------- 步骤 2/3：从记忆池A中提取非嵌套的 { } 与单对 [ ] 写入记忆池B --------------------
    # 规则：包含括号本身；提取非嵌套大括号 { ... }；提取单对中括号 [ ... ]，排除 [[ ... ]]（双中括号）
    memory_b_set = set()
    for line in memory_a_lines:
        curly_matches = re.findall(r"\{[^{}]*\}", line)
        # 匹配单对中括号，使用负向断言排除 [[...]]
        square_matches = re.findall(r"(?<!\[)\[[^\[\]]*\](?!\])", line)
        for m in curly_matches + square_matches:
            memory_b_set.add(m)

    memory_b_list = list(memory_b_set)
    with open(MEMORY_B_PATH, "w", encoding="utf-8") as f:
        for item in memory_b_list:
            f.write(item + "\n")
    print(f"记忆池B生成完成，{len(memory_b_list)} 条记录（共扫描 {file_count} 个 rpy 文件，提取到 {len(memory_a_lines)} 条引号内容）")

    # -------------------- 步骤 4：记忆池C 与 占位符配对写入 result.txt --------------------
    result_lines = []
    
    for index, item in enumerate(memory_b_list, 1):
        placeholder = generate_placeholder(index)
        result_lines.append(f"{item}   {placeholder}")

    with open(RESULT_PATH, "w", encoding="utf-8") as f:
        for line in result_lines:
            f.write(line + "\n")
    print(f"result.txt生成完成，共{len(result_lines)}条配对记录")
    
    # -------------------- 自动删除记忆池A 与 记忆池B --------------------
    try:
        if os.path.exists(MEMORY_A_PATH):
            os.remove(MEMORY_A_PATH)
        if os.path.exists(MEMORY_B_PATH):
            os.remove(MEMORY_B_PATH)
        print("已自动删除临时记忆池文件：记忆池A.txt、记忆池B.txt")
    except Exception as e:
        print(f"删除临时文件时出错：{e}")

    print("执行完成，脚本不会自动关闭，请手动关闭。")
    input("按回车键返回主菜单...")

def script_03():
    """03.生成正反替换表 - 原封不动"""
    print("=== 执行: 03.生成正反替换表 ===")
    
    import openpyxl
    import re
    import os

    # 最终输出文件名
    OUTPUT_FILENAME_POSITIVE = "result正.xlsx"
    OUTPUT_FILENAME_NEGATIVE = "result反.xlsx"
    INPUT_FILENAME = "result.txt"

    def write_data_to_excel(filename, data_list, column_order, title="占位符数据"):
        """
        将解析后的数据写入指定的 Excel 文件，并允许自定义列的顺序。
        """
        try:
            print(f"正在写入文件: {filename} ...")
            workbook = openpyxl.Workbook()
            sheet = workbook.active
            sheet.title = title

            # 设置列宽
            sheet.column_dimensions['A'].width = 40
            sheet.column_dimensions['B'].width = 40

            # 写入数据
            for row_index, (label, placeholder) in enumerate(data_list, 1):
                sheet.cell(row=row_index, column=1, value=(label, placeholder)[column_order[0]])
                sheet.cell(row=row_index, column=2, value=(label, placeholder)[column_order[1]])

            # 保存文件
            workbook.save(filename)
            print(f"✅ 写入完成: {filename}")
            return True
        except Exception as e:
            print(f"❌ 写入文件 {filename} 失败: {e}")
            return False


    def convert_txt_to_excel_dual(input_filename=INPUT_FILENAME):
        """
        读取 result.txt，解析内容，并生成 result正.xlsx 和 result反.xlsx。
        """
        print("="*50)
        print("开始 Excel 转换流程...")
        print("="*50)

        # 1. 读取文件
        print(f"\n步骤1: 读取文件: {input_filename}")
        try:
            with open(input_filename, 'r', encoding='utf-8') as f:
                lines = f.readlines()
            print(f"✅ 成功读取 {len(lines)} 行内容")
        except FileNotFoundError:
            print(f"❌ 错误: 找不到文件 {input_filename}。")
            input("按回车键返回主菜单...")
            return
        except Exception as e:
            print(f"❌ 读取文件时发生错误: {e}")
            input("按回车键返回主菜单...")
            return

        # 2. 解析数据
        print("\n步骤2: 解析内容为 [内容] 和 Emoji 对")
        parsed_data = []
        pattern = re.compile(r'^\s*(.+?)\s+([^\s]+)\s*$', re.UNICODE)

        for line_number, line in enumerate(lines, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue

            match = pattern.match(line)
            if match:
                content = match.group(1).strip()
                emoji = match.group(2).strip()
                parsed_data.append((content, emoji))
            else:
                print(f"⚠️ 警告: 第 {line_number} 行未匹配成功，跳过: {line}")

        if not parsed_data:
            print("❌ 未解析到任何有效数据，程序终止。")
            input("按回车键返回主菜单...")
            return

        print(f"✅ 数据解析完成，共 {len(parsed_data)} 条有效记录。")

        # 3. 生成 Excel 文件
        print("\n步骤3: 生成 Excel 文件")

        # 3.1 result正.xlsx (正向: 左列 [内容], 右列 Emoji)
        print("\n生成 result正.xlsx (正向)")
        success_positive = write_data_to_excel(
            OUTPUT_FILENAME_POSITIVE,
            parsed_data,
            column_order=(0, 1),
            title="正向对照"
        )

        # 3.2 result反.xlsx (反向: 左列 Emoji, 右列 [内容])
        print("\n生成 result反.xlsx (反向)")
        success_negative = write_data_to_excel(
            OUTPUT_FILENAME_NEGATIVE,
            parsed_data,
            column_order=(1, 0),
            title="反向对照"
        )

        print("\n" + "="*50)
        if success_positive and success_negative:
            print(f"✅ Excel 文件生成完成！")
        else:
            print(f"❌ Excel 文件生成过程中出现问题，请检查日志。")
        print(f"正向文件: {os.path.abspath(OUTPUT_FILENAME_POSITIVE)}")
        print(f"反向文件: {os.path.abspath(OUTPUT_FILENAME_NEGATIVE)}")
        print("="*50)

        # 4. 手动关闭脚本
        input("脚本执行完毕，请按回车键返回主菜单...")


    convert_txt_to_excel_dual()


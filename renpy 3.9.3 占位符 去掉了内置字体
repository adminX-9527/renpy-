def script_04():
    """04.提取人名2.0 - 修改版"""
    print("=== 执行: 04.提取人名2.0 ===")
    
    import os
    import re
    from pathlib import Path

    # --- 常量定义 ---
    # 1：脚本所在目录即为游戏根目录
    GAME_ROOT = Path(ROOT_DIR)

    # 2：在游戏根目录生成记忆池文件和辅助文件
    POOL_A = GAME_ROOT / "记忆池A.txt"
    POOL_B = GAME_ROOT / "记忆池B.txt"
    POOL_C = GAME_ROOT / "记忆池C.txt"
    POOL_D = GAME_ROOT / "记忆池D.txt"
    POOL_E = GAME_ROOT / "记忆池E.txt"
    NAME_DELE = GAME_ROOT / "NameDele.txt"
    NAME_TXT = GAME_ROOT / "name.txt"
    NAME_RPY = GAME_ROOT / "name.rpy"

    # 定义符A
    DEFINER_A = "\n----------------截断---------------\n"

    # 日志输出函数
    def log(message):
        print(f"[LOG] {message}")

    # --- 核心逻辑函数 ---

    def step_2():
        """步骤2：生成文件"""
        log("步骤2: 检查/创建工作目录和文件...")
        
        # 在游戏根目录生成文件
        for f in [POOL_A, POOL_B, POOL_C, POOL_D, POOL_E, NAME_DELE, NAME_TXT, NAME_RPY]:
            try:
                f.touch(exist_ok=True)
                # 清空文件内容
                with open(f, "w", encoding="utf-8") as file:
                    file.write("")
                log(f"  - 文件 {f.name} 确保存在并已清空。")
            except Exception as e:
                log(f"  - 错误: 无法创建或访问文件 {f.name}: {e}")
                return False

        log("  - 定义符A 已定义。")
        log("步骤2 完成。")
        return True

    def step_3():
        """步骤3：遍历读取game目录内的rpy文件并提取角色名"""
        log("步骤3: 遍历game目录并提取角色名到记忆池A...")
        
        game_dir = GAME_ROOT / "game"
        tl_dir = game_dir / "tl"
        
        if not game_dir.is_dir():
            log(f"  - 错误: 游戏根目录缺少'game'文件夹。")
            return False
            
        all_names = []
        
        # 查找game及其子文件夹内的全部rpy文件
        rpy_files = [p for p in game_dir.rglob("*.rpy")]
        
        # 排除game/tl内的rpy文件
        valid_rpy_files = [p for p in rpy_files if not str(p).startswith(str(tl_dir))]

        # 定义正则表达式
        pattern = re.compile(
            r'''
            ^\s*                                   # 行首可有空格
            (?:define|default)\s+                  # define 或 default
            (?P<var>[A-Za-z_][A-Za-z0-9_]*)       # 变量名
            \s*=\s*                                # 等号
            (?:                                    # 非捕获组，匹配两种情况
                ['"](?P<name1>[^'"]+)['"]         # 直接字符串赋值
                |
                Character\s*\(\s*                  # Character(
                    (?:_\(\s*)?                    # 可选 _(
                    ['"](?P<name2>[^'"]+)['"]     # Character 名字
            )
            ''',
            re.VERBOSE | re.MULTILINE
        )

        for rpy_file in valid_rpy_files:
            try:
                with open(rpy_file, "r", encoding="utf-8") as f:
                    content = f.read()
                    matches = pattern.findall(content)
                    if matches:
                        for match in matches:
                            # match[0]是变量名，match[1]是直接字符串，match[2]是Character中的名字
                            name = match[1] if match[1] else match[2]
                            if name and name.strip():
                                all_names.append(name.strip())
                        log(f"  - 从 {rpy_file.relative_to(GAME_ROOT)} 提取到 {len(matches)} 个角色名。")
            except UnicodeDecodeError:
                log(f"  - 警告: 无法以utf-8读取文件 {rpy_file.name}，跳过。")
            except Exception as e:
                log(f"  - 错误: 读取文件 {rpy_file.name} 发生错误: {e}")
                
        # 写入记忆池A
        try:
            with open(POOL_A, "w", encoding="utf-8") as f:
                for name in all_names:
                    f.write(name + "\n")
            log(f"  - 成功将 {len(all_names)} 个角色名写入记忆池A.txt。")
        except Exception as e:
            log(f"  - 错误: 写入记忆池A.txt失败: {e}")
            return False

        log("步骤3 完成。")
        return True

    def step_4():
        """步骤4：处理记忆池A内容"""
        log("步骤4: 处理记忆池A内容...")
        
        try:
            with open(POOL_A, "r", encoding="utf-8") as f:
                lines_A = [l.strip() for l in f.readlines()]
        except FileNotFoundError:
            log("  - 错误: 记忆池A.txt未找到。")
            return False

        # 去重处理
        unique_lines = list(set([line for line in lines_A if line]))
        log(f"  - 记忆池A去重后剩余 {len(unique_lines)} 个非空行。")

        # 用于存放将被保留在记忆池A中的行
        lines_to_keep_in_A = unique_lines.copy()

        # 剪切开头不是字母的行
        non_alpha_start = [line for line in lines_to_keep_in_A if not re.match(r"^[a-zA-Z]", line)]
        lines_to_keep_in_A = [line for line in lines_to_keep_in_A if re.match(r"^[a-zA-Z]", line)]
        log(f"  - 剪切 {len(non_alpha_start)} 行(开头不是字母)到NameDele.txt。")

        # 再次剪切首字母不是大写的行
        non_upper_start = [line for line in lines_to_keep_in_A if not re.match(r"^[A-Z]", line)]
        lines_to_keep_in_A = [line for line in lines_to_keep_in_A if re.match(r"^[A-Z]", line)]
        log(f"  - 再次剪切 {len(non_upper_start)} 行(首字母不是大写)到NameDele.txt。")

        # 写入NameDele
        deleted_lines = non_alpha_start + non_upper_start
        try:
            with open(NAME_DELE, "a", encoding="utf-8") as f:
                for line in deleted_lines:
                    f.write(line + "\n")
                f.write(DEFINER_A)
            log(f"  - 成功将 {len(deleted_lines)} 行内容追加写入NameDele.txt并写入定义符A。")
        except Exception as e:
            log(f"  - 错误: 写入NameDele.txt失败: {e}")

        # 将保留的行写回记忆池A
        try:
            with open(POOL_A, "w", encoding="utf-8") as f:
                for line in lines_to_keep_in_A:
                    f.write(line + "\n")
            log(f"  - 记忆池A更新为保留的 {len(lines_to_keep_in_A)} 行内容。")
        except Exception as e:
            log(f"  - 错误: 更新记忆池A.txt失败: {e}")
            return False

        log("步骤4 完成。")
        return True

    def step_5():
        """步骤5：复制记忆池A到记忆池B"""
        log("步骤5: 复制记忆池A内容到记忆池B...")
        
        try:
            with open(POOL_A, "r", encoding="utf-8") as a:
                lines_A = [l.strip() for l in a.readlines() if l.strip()]
        except FileNotFoundError:
            log("  - 错误: 记忆池A.txt未找到。")
            return False

        try:
            with open(POOL_B, "w", encoding="utf-8") as b:
                for line in lines_A:
                    b.write(line + "\n")
            log(f"  - 成功将 {len(lines_A)} 行内容复制写入记忆池B.txt。")
        except Exception as e:
            log(f"  - 错误: 写入记忆池B.txt失败: {e}")
            return False

        log("步骤5 完成。")
        return True

    def step_6():
        """步骤6：过滤记忆池B内容"""
        log("步骤6: 过滤记忆池B内容...")
        
        try:
            with open(POOL_B, "r", encoding="utf-8") as f:
                lines_B = [l.strip() for l in f.readlines() if l.strip()]
        except FileNotFoundError:
            log("  - 错误: 记忆池B.txt未找到。")
            return False

        # 规则: [\(\)\{\}\[\]\d\\\/#!]
        filter_pattern = re.compile(r"[\(\)\{\}\[\]\d\\\/#!]")
        
        to_namedele = []
        to_name_txt_and_C = []
        
        for line in lines_B:
            if filter_pattern.search(line):
                to_namedele.append(line)
            else:
                to_name_txt_and_C.append(line)

        # 写入NameDele
        try:
            with open(NAME_DELE, "a", encoding="utf-8") as f:
                for line in to_namedele:
                    f.write(line + "\n")
                f.write(DEFINER_A)
            log(f"  - 成功将 {len(to_namedele)} 行(符合过滤规则)追加写入NameDele.txt并写入定义符A。")
        except Exception as e:
            log(f"  - 错误: 写入NameDele.txt失败: {e}")
            
        # 写入name.txt与记忆池C
        try:
            with open(NAME_TXT, "w", encoding="utf-8") as f_name, open(POOL_C, "w", encoding="utf-8") as f_c:
                for line in to_name_txt_and_C:
                    f_name.write(line + "\n")
                    f_c.write(line + "\n")
            log(f"  - 成功将 {len(to_name_txt_and_C)} 行内容写入name.txt和记忆池C.txt。")
        except Exception as e:
            log(f"  - 错误: 写入name.txt或记忆池C.txt失败: {e}")
            return False

        log("步骤6 完成。")
        return True

    def step_7():
        """步骤7：提取翻译文件内容到记忆池D"""
        log("步骤7: 遍历tl/schinese目录提取字符串到记忆池D...")
        
        schinese_dir = GAME_ROOT / "game" / "tl" / "schinese"
        
        if not schinese_dir.is_dir():
            log(f"  - 错误: 缺少'game/tl/schinese'文件夹。")
            return False
            
        all_strings = set()

        # 查找schinese及其子文件夹内的全部rpy文件
        rpy_files = schinese_dir.rglob("*.rpy")
        
        # 严格使用规则: "((?:\\.|[^"\\])*)" 提取内容
        string_pattern = re.compile(r'"((?:\\.|[^"\\])*)"')

        for rpy_file in rpy_files:
            try:
                with open(rpy_file, "r", encoding="utf-8") as f:
                    content = f.read()
                    matches = string_pattern.findall(content)
                    if matches:
                        for match in matches:
                            if match.strip():
                                all_strings.add(match)
                        log(f"  - 从 {rpy_file.relative_to(GAME_ROOT)} 提取到 {len(matches)} 个字符串内容。")
            except UnicodeDecodeError:
                log(f"  - 警告: 无法以utf-8读取文件 {rpy_file.name}，跳过。")
            except Exception as e:
                log(f"  - 错误: 读取文件 {rpy_file.name} 发生错误: {e}")
                
        # 写入记忆池D
        all_strings_list = list(all_strings)
        try:
            with open(POOL_D, "w", encoding="utf-8") as f:
                for s in all_strings_list:
                    f.write(s + "\n")

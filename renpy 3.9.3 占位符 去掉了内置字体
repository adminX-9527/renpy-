            else:
                print("    未找到插入位置，跳过。\n")

            continue

        # === 2：若未发现 archive，则查找 classify ===
        match_classify = pattern_classify.search(content)
        if match_classify:
            found_classify = True
            print(f"[+] 检测到 build.classify: {os.path.relpath(rpy_path, game_root)}")


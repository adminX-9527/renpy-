def script_16():
    """16.删除错误的 {} .py - 修复路径问题"""
    print("=== 执行: 16.删除错误的 {} .py ===")
    
    import os
    import re
    import datetime
    import sys

    def extract_brackets(text):
        """提取文本中的所有大括号标签"""
        return re.findall(r'\{[^}]*\}', text)

    def process_translation_pair(orig_line, trans_line, line_num, filename, log_file):
        """处理一对原文和译文，检查大括号一致性"""
        orig_brackets = extract_brackets(orig_line)
        trans_brackets = extract_brackets(trans_line)
        
        # 如果译文没有大括号，直接跳过
        if not trans_brackets:
            return trans_line, False
        
        # 检查大括号顺序、内容、结构是否一致
        if orig_brackets == trans_brackets:
            return trans_line, False
        
        # 大括号不一致，删除译文中的所有大括号内容
        repaired_line = re.sub(r'\{[^}]*\}', '', trans_line)
        
        # 记录修复日志
        log_file.write(f"第{line_num}行 - 大括号不一致:\n")
        log_file.write(f"原文: {orig_line.strip()}\n")
        log_file.write(f"译文: {trans_line.strip()}\n")
        log_file.write(f"修复后：{repaired_line.strip()}\n")
        log_file.write(f"原文括号: {orig_brackets}\n")
        log_file.write(f"译文括号: {trans_brackets}\n")
        log_file.write("--------------------------------------------------\n")
        
        return repaired_line, True

    def process_rpy_file(filepath, log_file):
        """处理单个rpy文件"""
        filename = os.path.basename(filepath)
        print(f"检查修复文件: {filename}")
        
        log_file.write("=" * 60 + "\n")
        log_file.write(f"检查修复文件: {filename}\n")
        log_file.write(f"检查时间: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
        log_file.write("=" * 60 + "\n")
        
        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                lines = f.readlines()
        except Exception as e:
            print(f"❌ 读取文件失败: {e}")
            log_file.write(f"❌ 读取文件失败: {e}\n")
            log_file.write("=" * 60 + "\n\n")
            return
        
        modified = False
        new_lines = []
        i = 0
        total_lines = len(lines)
        
        while i < total_lines:
            line = lines[i]
            new_lines.append(line)
            
            # 检查是否是原文行（以#开头且包含引号）
            if line.strip().startswith('#') and '"' in line:
                orig_line = line
                
                # 检查下一行是否是译文行（不以#开头且包含引号）
                if i + 1 < total_lines and not lines[i + 1].strip().startswith('#') and '"' in lines[i + 1]:
                    trans_line = lines[i + 1]
                    
                    # 处理翻译对
                    repaired_line, was_repaired = process_translation_pair(
                        orig_line, trans_line, i + 2, filename, log_file
                    )
                    
                    if was_repaired:
                        modified = True
                        new_lines.append(repaired_line + '\n')
                        i += 2  # 跳过已处理的译文行
                        continue
            
            i += 1
        
        # 如果有修改，写回文件
        if modified:
            try:
                with open(filepath, 'w', encoding='utf-8') as f:
                    f.writelines(new_lines)
                print(f"✅ 文件已修复")
            except Exception as e:
                print(f"❌ 写入文件失败: {e}")
                log_file.write(f"❌ 写入文件失败: {e}\n")
        else:
            print("✅ 文件无需修复，所有翻译对的括号标记都一致！")
            log_file.write("✅ 文件无需修复，所有翻译对的括号标记都一致！\n")
        
        log_file.write("=" * 60 + "\n\n")

    def main():
        """主函数"""
        # 使用工具箱统一的根目录
        script_dir = ROOT_DIR
        
        # 目标目录
        target_dir = os.path.join(script_dir, "game", "tl", "schinese")
        
        if not os.path.exists(target_dir):
            print(f"❌ 目标目录不存在: {target_dir}")
            print("请确保脚本在游戏根目录运行")
            input("按回车键退出...")
            return
        
        # 设置日志文件
        log_filepath = os.path.join(script_dir, "translation_repair.log")
        
        try:
            with open(log_filepath, 'w', encoding='utf-8') as log_file:
                log_file.write("翻译修复日志\n")
                log_file.write(f"开始时间: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
                log_file.write("=" * 60 + "\n\n")
                
                # 查找所有rpy文件
                rpy_files = []
                for root, dirs, files in os.walk(target_dir):
                    for file in files:
                        if file.endswith('.rpy'):
                            rpy_files.append(os.path.join(root, file))
                
                if not rpy_files:
                    print("❌ 未找到任何rpy文件")
                    log_file.write("❌ 未找到任何rpy文件\n")
                    return
                
                print(f"找到 {len(rpy_files)} 个rpy文件")
                print("开始检查修复...\n")
                
                # 处理每个rpy文件
                for rpy_file in rpy_files:
                    process_rpy_file(rpy_file, log_file)
                
                log_file.write(f"完成时间: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
                print("\n✅ 所有文件处理完成！")
                
        except Exception as e:
            print(f"❌ 程序执行出错: {e}")
        
        print("\n程序执行完毕，请查看 translation_repair.log 文件了解详细情况")
        input("按回车键返回主菜单...")

    # 调用主函数
    main()

